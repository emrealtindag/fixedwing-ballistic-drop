<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>TEKNOFEST Direkleri</name>
    <description>Gorev 1 - 8 cizme direkleri (150m aralik)</description>

    <Style id="poleStyle">
      <IconStyle>
        <color>ff0000ff</color>
        <scale>1.5</scale>
        <Icon>
          <href>http://maps.google.com/mapfiles/kml/pushpin/red-pushpin.png</href>
        </Icon>
      </IconStyle>
      <LabelStyle>
        <color>ff0000ff</color>
        <scale>1.2</scale>
      </LabelStyle>
    </Style>

    <Placemark>
      <name>1. DIREK (SOL)</name>
      <description>1. Direk - Ucus alani sol siniri</description>
      <styleUrl>#poleStyle</styleUrl>
      <Point>
        <coordinates>38.25411899,38.35393990,0</coordinates>
      </Point>
    </Placemark>

    <Placemark>
      <name>2. DIREK (SAG)</name>
      <description>2. Direk - Ucus alani sag siniri</description>
      <styleUrl>#poleStyle</styleUrl>
      <Point>
        <coordinates>38.25533401,38.35489270,0</coordinates>
      </Point>
    </Placemark>

    <Placemark>
      <name>BITIS/BASLANGIC CIZGISI</name>
      <description>Kronometre burada durur</description>
      <Style>
        <IconStyle>
          <color>ff00ff00</color>
          <scale>1.3</scale>
          <Icon>
            <href>http://maps.google.com/mapfiles/kml/pushpin/grn-pushpin.png</href>
          </Icon>
        </IconStyle>
      </Style>
      <Point>
        <coordinates>38.25411899,38.35393990,0</coordinates>
      </Point>
    </Placemark>

    <Placemark>
      <name>Direkler Arasi Mesafe</name>
      <description>150 metre</description>
      <LineString>
        <coordinates>
          38.25411899,38.35393990,0
          38.25533401,38.35489270,0
        </coordinates>
      </LineString>
      <Style>
        <LineStyle>
          <color>ff0000ff</color>
          <width>3</width>
        </LineStyle>
      </Style>
    </Placemark>

  </Document>
</kml>