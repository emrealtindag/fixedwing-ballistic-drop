  </camera>
  <always_on>1</always_on>
  <update_rate>30</update_rate>
  <visualize>true</visualize>
  <plugin name="camera_plugin_down" filename="libgazebo_ros_camera.so">
    <alwaysOn>true</alwaysOn>
    <imageTopicName>/downward_camera/image_raw</imageTopicName>
    <cameraInfoTopicName>/downward_camera/camera_info</cameraInfoTopicName>
    <updateRate>30.0</updateRate>
    <cameraName>downward_camera</cameraName>
